# Copia este archivo a .env SOLO para pruebas locales. En Coolify estas variables se definen en la
# pestaña "Environment Variables" de la aplicación; nunca se suben al repositorio.

# Cadena de conexión de PostgreSQL (en Coolify: la "Postgres URL (internal)" del recurso de base de datos)
DATABASE_URL=postgres://usuario:clave@epis-db:5432/postgres

# Uno o más tokens separados por comas, de al menos 24 caracteres cada uno. Uno por cliente
# (móvil, web...) para poder revocar cualquiera sin afectar al resto.
# Genera cada uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKENS=token-del-movil-cambialo-por-uno-largo,token-de-la-web-cambialo-por-otro-largo

# Opcional
# PORT=3000
# DATABASE_SSL=true                     # solo si la base de datos exige TLS (no hace falta en la red interna de Coolify)
# CORS_ORIGIN=https://cae-symisa.vercel.app   # solo si el NAVEGADOR llama directamente a la API (lo recomendable es llamar desde el servidor de la web)
# LOG_LEVEL=info
